# Required: a GitHub token that can create issues and push to the asset branch.
# Fine-grained PAT: "Issues: write" and "Contents: write" on the target repo.
GITHUB_TOKEN=
# Required: where issues are filed, as owner/name.
GITHUB_REPO=

# Optional. Defaults shown.
# Repo the screenshots are committed to (default: GITHUB_REPO).
GITHUB_ASSET_REPO=
# Branch inside that repo that holds the screenshots; created on first use as an orphan branch.
GITHUB_ASSET_BRANCH=report-screenshots
# Comma-separated labels and assignees for every issue.
GITHUB_LABELS=user-report
GITHUB_ASSIGNEES=
# GitHub Enterprise: API base and web base.
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# Comma-separated list of page origins allowed to submit reports. "*" allows any.
ALLOWED_ORIGINS=*
# Reports per client IP per minute.
RATE_LIMIT=10
PORT=8787
