{
  "name": "report-button",
  "version": "0.1.0",
  "description": "A drop-in \"Report a problem\" button: the user annotates a screenshot of what they see, and it lands as a GitHub issue.",
  "license": "MIT",
  "author": "Caleb Cauthon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calebcauthon/report-button.git"
  },
  "type": "module",
  "main": "./dist/report-button.esm.js",
  "module": "./dist/report-button.esm.js",
  "jsdelivr": "./dist/report-button.js",
  "unpkg": "./dist/report-button.js",
  "types": "./dist/types/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/client/index.d.ts",
      "import": "./dist/report-button.esm.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:client && npm run build:server && npm run build:types",
    "build:client": "esbuild src/client/browser.ts --bundle --minify --format=iife --target=es2020 --outfile=dist/report-button.js && esbuild src/client/index.ts --bundle --format=esm --target=es2020 --packages=external --outfile=dist/report-button.esm.js && cp demo/demo.html dist/demo.html",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.js",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\"",
    "dev": "npm run build:client && node --experimental-strip-types --no-warnings --watch src/server/index.ts",
    "start": "node dist/server.js",
    "fixture": "npm run build:client && node --experimental-strip-types --no-warnings fixture/start.ts",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "readme-images": "npm run build:client && node --experimental-strip-types --no-warnings scripts/readme-images.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "@playwright/test": "^1.50.0"
  }
}
