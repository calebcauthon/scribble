# Set one or both of these two modes.

# GitHub App mode: files into any repo that installs the app. Open /setup/app on a
# running server to register the app; it shows these three values.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The PEM; literal \n line breaks are fine for hosts that take single-line values.
GITHUB_APP_PRIVATE_KEY=

# Token mode: one repo. Fine-grained PAT with "Issues: write" and "Contents: write".
GITHUB_TOKEN=
GITHUB_REPO=

# Optional. Defaults shown.
# Repo the screenshots are committed to (default: GITHUB_REPO).
GITHUB_ASSET_REPO=
# Branch inside that repo that holds the screenshots; created on first use as an orphan branch.
GITHUB_ASSET_BRANCH=report-screenshots
# Comma-separated labels and assignees for every issue.
GITHUB_LABELS=user-report
GITHUB_ASSIGNEES=
# GitHub Enterprise: API base and web base.
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# Public URL of this server, for setup links (default: taken from the request).
PUBLIC_URL=
# Token mode: comma-separated page origins allowed to submit. "*" allows any.
# App mode reads origins from each repo's .github/report-button.yml instead.
ALLOWED_ORIGINS=*
# Reports per client IP per minute.
RATE_LIMIT=10
PORT=8787
